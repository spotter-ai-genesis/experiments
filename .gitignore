.venv/
__pycache__/
.ruff_cache/
.pytest_cache/

# Generated, and regenerated by scripts/run_suite.sh on every invocation. The
# manifests are kept: they record exactly what each arm changed.
bench/opal/data/poisoned/*.csv
runs/

# analytics-out/ IS committed: it is the only durable record of the capture.
# The tensors it was reduced from are 13 GB and live only on the GPU box, so
# regenerating it is not possible from this repository alone.

# Clones setup_box.sh makes when flowcept / vllm-attn-connector are not
# already on the machine. They are separate repositories with their own
# history; committing them here would vendor a second copy.
vendor/
requirements.gpu.lock
